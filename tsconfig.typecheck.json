{
    // Type-checks everything, shipped or not: the sources, the tests, the
    // benchmark harness under bench/ and the test runner's own config.
    // The root tsconfig.json compiles src/ alone, on purpose — the package has no
    // runtime dependency on Node, and its `lib` is ES2022 plus WebWorker (the
    // embedding adapters need fetch, Response and AbortSignal). WebWorker declares
    // no `document` and no `window` — verified — but it DOES declare `caches` and
    // `indexedDB` (lib.webworker.d.ts:14938 and :14944), which exist in a Worker
    // and not in Node. Nothing in src/ uses them and nothing should: they would
    // type-check here and throw ReferenceError under the runtime `engines`
    // declares. The distinction that matters here is Node, not the web globals. The tests do use Node
    // (fs, process, Buffer), and with the installed toolchain @types/node is
    // not picked up without an explicit `types` entry; measured on 2026-09-07:
    // without it, 9 × TS2591 in the tests; with it, zero. `rootDir` widens to the
    // repository root because tests/ lives outside src/ (TS6059 otherwise), and
    // nothing is emitted here.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src", "tests", "bench", "vitest.config.ts"]
}
