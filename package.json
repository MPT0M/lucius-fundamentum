{
  "name": "@nihilo-dev/fundamentum",
  "version": "0.1.0",
  "description": "Document grounding with code-point-exact positions: formula-safe sentence chunking, Unicode normalization, lexical and hybrid search, and attribution that says which passage supports which stretch of an answer.",
  "license": "Apache-2.0",
  "author": "MPT0M <dev@nihilo.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MPT0M/lucius-fundamentum.git"
  },
  "homepage": "https://github.com/MPT0M/lucius-fundamentum#readme",
  "bugs": "https://github.com/MPT0M/lucius-fundamentum/issues",
  "keywords": [
    "unicode",
    "code-points",
    "chunking",
    "sentence-segmentation",
    "latex",
    "portuguese",
    "grounding"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.bench.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsc -p tsconfig.bench.json && node bench/.out/bench/src/main.js",
    "bench:corpus": "tsc -p tsconfig.bench.json && node bench/.out/bench/src/corpus-probe.js",
    "bench:cost": "tsc -p tsconfig.bench.json && node bench/.out/bench/src/attribution-cost.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
